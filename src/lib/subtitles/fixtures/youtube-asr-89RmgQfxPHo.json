      "wWinId": 1,
      "segs": [
        {
          "utf8": "武氏は当農林部会長や農水副大臣を務めたこの分野専門家で予算委員会の途中での交代という政権にとって危機的な状況の中で戦力を重視した形です。",
          "acAsrConf": 0
        }
      ]
    },
    { "tStartMs": 16070, "wWinId": 1, "aAppend": 1, "segs": [{ "utf8": "\n" }] },
    {
      "tStartMs": 16080,
      "dDurationMs": 3000,
      "wWinId": 1,
      "segs": [
        { "utf8": "農林水産業行政にとって大変重要な局面を迎えているという風に思っております。", "acAsrConf": 0, "isSpeakerChange": 1 }
      ]
    },
    { "tStartMs": 20870, "wWinId": 1, "aAppend": 1, "segs": [{ "utf8": "\n" }] },
    {
      "tStartMs": 20880,
      "dDurationMs": 3000,
      "wWinId": 1,
      "segs": [
        { "utf8": "部会長もやってるし、副大臣もやってるので、え、全部あの頭に入ってるはずだからしっかりやってくださいと。", "acAsrConf": 0 }
      ]
    },
    { "tStartMs": 32109, "wWinId": 1, "aAppend": 1, "segs": [{ "utf8": "\n" }] },
    {
      "tStartMs": 32119,
      "dDurationMs": 2120,
      "wWinId": 1,
      "segs": [{ "utf8": "一方、執からわずか", "acAsrConf": 0, "isSpeakerChange": 1 }]
    },
    { "tStartMs": 33990, "dDurationMs": 249, "wWinId": 1, "aAppend": 1, "segs": [{ "utf8": "\n" }] },

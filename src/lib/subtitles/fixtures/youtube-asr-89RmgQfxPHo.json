    {
      "tStartMs": 34239,
      "dDurationMs": 3000,
      "wWinId": 1,
      "segs": [{ "utf8": "ヶ月で閣僚が辞任に追い込まれたことに、今朝政権幹部の", "acAsrConf": 0 }]

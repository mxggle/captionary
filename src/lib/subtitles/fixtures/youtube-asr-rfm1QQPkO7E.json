    { "tStartMs": 32680, "dDurationMs": 5080, "wWinId": 1, "segs": [{ "utf8": "あの、ですね、", "acAsrConf": 0, "isSpeakerChange": 1 }] },
    { "tStartMs": 34750, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{ "utf8": "\n" }] },
    {
      "tStartMs": 34760,
      "dDurationMs": 3000,
      "wWinId": 1,
      "segs": [
        { "utf8": "新たに農林水産行政の式を取ることになったのは偉大なるイエスマンの息子です。", "acAsrConf": 0, "isSpeakerChange": 1 }
      ]
    },
    { "tStartMs": 41910, "wWinId": 1, "aAppend": 1, "segs": [{ "utf8": "\n" }] },

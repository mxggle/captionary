    {
      "tStartMs": 17439,
      "dDurationMs": 2921,
      "wWinId": 1,
      "segs": [
        {
          "utf8": "今日はす々しい朝を迎えることができまして、我が同士竹田君が、え、農林水産大臣に、ま、なったわけでありましておめでとうございます。",
          "acAsrConf": 0
